  "description": "Track Changes mode for Obsidian Live Preview and Source Mode using ++additions++ and %%~~deletions~~%%.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
